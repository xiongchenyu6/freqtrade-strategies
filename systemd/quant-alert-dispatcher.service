[Unit]
# User-facing Telegram alert dispatcher (game-box USER service, .venv-bots).
# Binds t.me deep-link tokens (quant.telegram_links) and fans out new signal events
# (DCA triggers, equity paper trades) to subscribed chats. The retention loop behind
# the dashboard's 订阅信号 feature. This is the ONLY getUpdates consumer for the bot.
#
# Install:
#   chmod +x start_alert_dispatcher.sh
#   cp systemd/quant-alert-dispatcher.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now quant-alert-dispatcher
Description=Quant Telegram alert dispatcher (user signal subscriptions)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/freeman.xiong/Documents/github/public/quant
Environment=PATH=/run/current-system/sw/bin:/home/freeman.xiong/Documents/github/public/quant/.venv-bots/bin:/etc/profiles/per-user/freeman.xiong/bin:/usr/bin:/bin
Environment=GNUPGHOME=/home/freeman.xiong/.gnupg
ExecStart=/home/freeman.xiong/Documents/github/public/quant/start_alert_dispatcher.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
