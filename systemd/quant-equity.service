[Unit]
# US-equity LIVE execution (IB PAPER) — game-box USER service. Runs the HonestTrendEquity
# TradingNode (live_honest_equity.py) on the nautilus venv, connecting to the IB Gateway on
# oracle-amd-002 over the WireGuard mesh (172.22.240.97:4002), and persisting fills/closed
# positions to quant.nautilus_trades (asset_class='equity', environment='paper') via the
# in-node TradeLedger. This is the SINGLE equity execution node — the older amd-002 nix node
# (services.nautilus-equity-trend) must be DISABLED so they don't both trade the one paper
# account (they share IB client id 8).
#
# HARD GUARDRAIL: PAPER ONLY. equity.env sets IB_TRADING_MODE=paper + IB_ACCOUNT=DU*; the node
# refuses to build otherwise. Never set IB_ALLOW_LIVE.
#
# Install (maintainer runs this; do NOT enable from CI):
#   mkdir -p ~/.config/quant
#   # create ~/.config/quant/equity.env (chmod 600) — see the keys in this unit's EnvironmentFile.
#   cp systemd/quant-equity.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now quant-equity.service
Description=Quant US-equity live execution — HonestTrendEquity on IB paper
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/freeman.xiong/Documents/github/public/quant
# IB connection + DB creds (mode 0600, not committed). Required keys:
#   IB_HOST IB_PORT IB_CLIENT_ID IB_ACCOUNT IB_TRADING_MODE=paper NAUTILUS_ENV=paper
#   NAUTILUS_ASSET_CLASS=equity EQ_QUOTE_PER_BASE_FX EQ_RISK_FRAC TIMESCALE_URL
EnvironmentFile=%h/.config/quant/equity.env
Environment=PATH=/home/freeman.xiong/Documents/github/public/quant/nautilus_equity/.venv/bin:/etc/profiles/per-user/freeman.xiong/bin:/run/current-system/sw/bin:/usr/bin:/bin
ExecStart=/home/freeman.xiong/Documents/github/public/quant/nautilus_equity/.venv/bin/python /home/freeman.xiong/Documents/github/public/quant/nautilus_equity/live_honest_equity.py
# IB sessions drop/reconnect; let systemd restart on failure. RestartSec gives the Gateway
# time to free the client id between attempts.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
