[Unit]
# Collects /market upstream data (Binance public + FNG) into quant.market_snapshots —
# Binance blocks Cloudflare egress and mainland-CN browsers; this box is the relay.
Description=Quant market data collector (Binance → market_snapshots)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/freeman.xiong/Documents/github/public/quant
EnvironmentFile=%h/.config/quant/backtest-runner.env
Environment=PATH=/run/current-system/sw/bin:/usr/bin:/bin
ExecStart=/home/freeman.xiong/Documents/github/public/quant/.venv-bots/bin/python strategies/market_collector.py
