[Unit]
# User-signal evaluator (game-box USER service, .venv-bots). Sweeps quant.user_signals
# every EVAL_INTERVAL (default 300s), evaluates each distinct config group on fresh PUBLIC
# market data (Binance klines / Yahoo daily / alternative.me FNG — no exchange keys), and
# inserts quant.signal_fires; quant-alert-dispatcher pushes those to bound Telegram chats.
#
# Install:
#   chmod +x start_signal_evaluator.sh
#   cp systemd/quant-signal-evaluator.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now quant-signal-evaluator
Description=Quant user-signal evaluator (backtest-to-live signal loop)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/freeman.xiong/Documents/github/public/quant
Environment=PATH=/run/current-system/sw/bin:/home/freeman.xiong/Documents/github/public/quant/.venv-bots/bin:/etc/profiles/per-user/freeman.xiong/bin:/usr/bin:/bin
Environment=GNUPGHOME=/home/freeman.xiong/.gnupg
ExecStart=/home/freeman.xiong/Documents/github/public/quant/start_signal_evaluator.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
